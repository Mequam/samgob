float = [0-9]*\.[0-9]+
integer = [0-9]+
negation = -
parenthasis = __P[0-9]+__
arithmatic_operator = <=|>=|<|>|==|\+|-|\*|/
matrix_column_operator = ,
matrix_row_operator = :
set_operator = T..D..B
set_compressor = d
unary_set_compressor = s
eos = ;
anything = .*
dash = :
first_dash = ^:
open_range = \{
close_range = \}
e = e
w = w
S = S
variable = [a-cefg-km-rt-vx-z]+
word = [^\s]+
matrix_function_operator = ~
equals = =





assignment = <variable><equals><arithmatic>|<variable><equals><set>
set = <set><set_operator><set>|<arithmatic>|<range>
number = <float>|<integer>
arithmatic =

            <matrix><matrix_function_operator><word>
            <variable><matrix_function_operator><word>
            <matrix>
            <negation><arithmatic>
            <arithmatic><arithmatic_operator><arithmatic>
            <arithmatic><set_compressor><set>
            <unary_set_compressor><set>
            <number>
            <variable>
            <parenthasis>

matrix = <matrix_row><matrix_row_operator><matrix> | <matrix_row>
matrix_row = <arithmatic><matrix_column_operator><arithmatic>


range = <open_range><number><negation><number><close_range>|<number>

for = <first_dash><arithmatic>
while = <first_dash><w><arithmatic>
flow_end = <first_dash><dash>
else = <first_dash><e>
control_flow = <else>|<for>|<while>|<flow_end>
print_control_flow = <control_flow><S><word> | <control_flow><S> | <control_flow>


expresion = <print_control_flow>|<assignment>|<arithmatic>|<set>
statement = <expresion><eos>
